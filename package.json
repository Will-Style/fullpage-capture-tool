{
  "name": "fullpage-capture",
  "version": "1.0.0",
  "description": "URLを指定してWebサイトのフルページキャプチャとスクロール動画をRetina解像度で取得するローカルWebアプリ",
  "main": "index.js",
  "scripts": {
    "postinstall": "playwright install chromium",
    "start": "node scripts/ensure-ui.js && node server.js",
    "dev": "concurrently -k -n api,ui -c cyan,magenta \"node server.js\" \"pnpm --filter fullpage-capture-ui dev\"",
    "build": "pnpm --filter fullpage-capture-ui build",
    "dev:ui": "pnpm --filter fullpage-capture-ui dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.4",
  "type": "commonjs",
  "dependencies": {
    "express": "^5.2.1",
    "playwright": "^1.62.1",
    "sharp": "^0.35.3"
  },
  "private": true,
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
